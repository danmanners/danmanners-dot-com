---
const post = Astro.props.post;
const href = `/posts/${post.id}/`;
const dateStr = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a
  href={href}
  class="group block rounded-xl border border-slate-200 bg-white p-5 transition-all hover:border-slate-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-900 dark:hover:border-slate-700"
>
  <h3 class="font-semibold text-slate-900 group-hover:text-slate-700 dark:text-white dark:group-hover:text-slate-300">
    {post.data.title}
  </h3>
  <time datetime={post.data.pubDate.toISOString()} class="mt-1 block text-sm text-slate-500 dark:text-slate-400">
    {dateStr}
  </time>
  {
    post.data.tags &&
    post.data.tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-1.5">
        {post.data.tags.slice(0, 4).map((tag: string) => (
          <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-600 dark:bg-slate-800 dark:text-slate-400">
            {tag}
          </span>
        ))}
      </div>
    )
  }
</a>
