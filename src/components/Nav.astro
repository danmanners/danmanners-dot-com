---
import ThemeToggle from './ThemeToggle.astro';

const links = [
  { text: 'About', href: '/about/' },
  { text: 'Posts', href: '/posts/' },
  { text: 'Resume', href: '/resume/' },
];
const currentPath = Astro.url.pathname;
---
<header class="no-print sticky top-0 z-50 border-b border-slate-200 bg-white/80 backdrop-blur dark:border-slate-800 dark:bg-slate-950/80">
  <nav class="mx-auto flex max-w-4xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <a href="/" class="font-semibold tracking-tight text-slate-900 dark:text-white">
      Dan Manners
    </a>
    <ul class="flex items-center gap-1 text-sm">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              class:list={[
                'rounded-md px-3 py-1.5 transition-colors',
                currentPath.startsWith(link.href)
                  ? 'bg-slate-100 font-medium text-slate-900 dark:bg-slate-800 dark:text-white'
                  : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-white',
              ]}
            >
              {link.text}
            </a>
          </li>
        ))
      }
      <li>
        <ThemeToggle />
      </li>
    </ul>
  </nav>
</header>
